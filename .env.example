# Bot Configuration
BOT_NAME=MyBot
OWNER_NUMBER=<country_code><number>

# Command prefixes (each character is a prefix)
PREFIXES=!.#/-

# Spam filter cooldown in milliseconds
SPAM_DELAY=5000

# Optional: Login via Pairing Code instead of QR scan
# PAIRING_NUMBER=<country_code><number>

# Default country code for phone number normalization
# (e.g. 62 for Indonesia, 55 for Brazil, 1 for USA)
DEFAULT_COUNTRY_CODE=62
